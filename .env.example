# Почта (по умолчанию письма уходят в Mailpit: http://localhost:8025).
# Пустой SMTP_HOST отключает рассылку. Для реального SMTP (пример: Gmail):
# SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_TLS=true
# SMTP_USER=you@gmail.com   SMTP_PASSWORD=<app password>  SMTP_FROM=devContest <you@gmail.com>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=devContest <noreply@devcontest.local>
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
FRONTEND_URL=http://localhost:3000
PYTEST_MAILPIT_URL=http://localhost:8025

EVALUATION_STUB=true
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral-small:24b
OLLAMA_VISION_MODEL=pixtral:12b

